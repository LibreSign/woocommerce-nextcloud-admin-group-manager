{
    "name": "libresign/woocommerce-nextcloud-admin-group-manager",
    "description": "Integrate WooCommerce with LibreSign SaaS using the Nextcloud app Admin Group Manager",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*"
            ]
        },
        {
            "type": "package",
            "package": {
                "name": "pronamic/woocommerce-subscriptions",
                "version": "9.2.0",
                "type": "wordpress-plugin",
                "source": {
                    "type": "git",
                    "url": "https://github.com/pronamic/woocommerce-subscriptions.git",
                    "reference": "0a2c496cd263811707caa37c8bf01ffa450c6009"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "composer/installers": "^2.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "php-stubs/woocommerce-stubs": "^9.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^9.6",
        "pronamic/woocommerce-subscriptions": "^9.2",
        "roots/wordpress": "^7.0",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.2",
        "wp-phpunit/wp-phpunit": "^7.0",
        "wpackagist-plugin/woocommerce": "^10.9",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "LibreSign\\WooNextcloud\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "roots/wordpress-core-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress",
        "installer-paths": {
            "vendor/test-plugins/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor .",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "ci": [
            "@lint",
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
