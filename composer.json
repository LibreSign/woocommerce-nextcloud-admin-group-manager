{
    "name": "libresign/woocommerce-nextcloud-admin-group-manager",
    "description": "Integrate WooCommerce with LibreSign SaaS using the Nextcloud app Admin Group Manager",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*"
            ]
        },
        {
            "type": "package",
            "package": {
                "name": "pronamic/woocommerce-subscriptions",
                "version": "9.2.0",
                "type": "wordpress-plugin",
                "source": {
                    "type": "git",
                    "url": "https://github.com/pronamic/woocommerce-subscriptions.git",
                    "reference": "0a2c496cd263811707caa37c8bf01ffa450c6009"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "composer/installers": "^2.3",
        "pronamic/woocommerce-subscriptions": "^9.2",
        "roots/wordpress": "^7.0",
        "wp-phpunit/wp-phpunit": "^7.0",
        "wpackagist-plugin/woocommerce": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "LibreSign\\WooNextcloud\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibreSign\\WooNextcloud\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "composer/installers": true,
            "roots/wordpress-core-installer": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        },
        "wordpress-install-dir": "vendor/wordpress",
        "installer-paths": {
            "vendor/test-plugins/{$name}/": [
                "type:wordpress-plugin"
            ]
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude vendor-bin .",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit",
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit -c phpunit-coverage.xml.dist --coverage-clover=tests/.coverage/clover.xml"
        ],
        "ci": [
            "@lint",
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
